# `cp env.example .env` してから値を入れてください

# Anam (https://lab.anam.ai) の API キー
ANAM_API_KEY=

# 既定で使う LLM: claude | openai（画面のプルダウンで通話ごとに切り替えも可）
LLM_PROVIDER=claude

# --- Claude ---（`ant auth login` 済みならキーは空でも可）
ANTHROPIC_API_KEY=
# 応答の速さを優先するなら claude-haiku-5-5 も選択肢
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high。音声会話では low 推奨（考える時間＝待ち時間）
CLAUDE_EFFORT=low

# --- OpenAI ---
OPENAI_API_KEY=
# 応答の速さを優先するなら gpt-6-luna（reasoning を none にできる）
OPENAI_MODEL=gpt-6.1-sol
# none(luna のみ) | low | medium | high
OPENAI_REASONING_EFFORT=low

# 1 セッションの最大秒数（Anam の Explorer プランは 600 秒が上限。Growth 以上は無制限）
ANAM_MAX_SESSION_SECONDS=600

# 取得元ごとに過去24時間の投稿全件、5件未満なら期間を問わず最新5件から話題とコメントを用意する。
# Slashdot・Full DisclosureのフィードとGitHubの公式アドバイザリAPIを取得し、選択中の LLM で要約する。
# false にすると通常の挨拶のみ。
NEWS_ON_CONNECT=true
# 準備した話題・要約・出典・コメントのJSON保存先。相対パスはプロジェクトルート基準。
PREPARATION_DIR=data/preparations
# GitHub Advisory DatabaseのAPIトークン（任意）。未設定でも公開情報を取得できる。
GITHUB_ADVISORY_TOKEN=

PERSONA_FILE=persona.yaml
